{
  "name": "@red-cup-engineering/eavt-terminal-projectors",
  "version": "0.1.0",
  "type": "module",
  "description": "EAVT settled-section projections for cell and raster terminal interfaces.",
  "engines": {
    "node": ">=20"
  },
  "bin": {
