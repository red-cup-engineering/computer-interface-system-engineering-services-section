{
  "name": "@emsenn/app-obsidian-knowledge-vault",
  "version": "0.0.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "A desktop Obsidian vault app that mounts the 561 content knowledge vault through @emsenn/organizing-a-knowledge-vault and exposes bounded vault tooling as Obsidian commands.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs'); for (const p of ['dist','vault/.obsidian/plugins/knowledge-vault/main.js','vault/.obsidian/plugins/knowledge-vault/main.js.map']) fs.rmSync(p,{recursive:true,force:true});\"",
    "build:deps": "pnpm --filter @emsenn/organizing-a-knowledge-vault --filter @emsenn/producing-content --filter @emsenn/organizing-with-agents --filter @emsenn/organizing-with-llm-agents --filter @emsenn/organizing-with-openai-agents run build",
    "check:local": "tsc --noEmit",
    "check:plugin": "tsc -p tsconfig.plugin.json --noEmit",
    "check": "pnpm run build:deps && pnpm run check:local && pnpm run check:plugin",
    "build:local": "tsc -p tsconfig.build.json",
    "sync:plugin-assets": "node scripts/package-plugin.mjs --sync",
    "install:plugin": "node scripts/package-plugin.mjs --install",
    "build:plugin": "tsc -p tsconfig.plugin.json && pnpm run sync:plugin-assets",
    "build": "pnpm run build:deps && pnpm run build:local && pnpm run build:plugin",
    "package:plugin": "pnpm run build && node scripts/package-plugin.mjs",
    "tool": "node dist/scripts/tool.mjs",
    "doctor": "node dist/scripts/doctor.mjs",
    "agent": "node dist/scripts/agent.mjs",
    "agent:list": "node dist/scripts/agent.mjs --list",
    "cockpit": "node dist/scripts/cockpit.mjs",
    "cockpit:markdown": "node dist/scripts/cockpit.mjs --markdown",
    "serve": "node dist/scripts/serve.mjs",
    "verify": "pnpm run check && pnpm run build",
    "rebuild": "pnpm run clean && pnpm run build"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "obsidian-knowledge-vault": "./dist/scripts/tool.mjs",
    "obsidian-knowledge-doctor": "./dist/scripts/doctor.mjs",
    "obsidian-knowledge-agent": "./dist/scripts/agent.mjs",
    "obsidian-knowledge-cockpit": "./dist/scripts/cockpit.mjs",
    "obsidian-knowledge-vault-serve": "./dist/scripts/serve.mjs"
  },
  "files": [
    "dist",
    "plugin",
    "vault",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./tooling": {
      "types": "./dist/tooling.d.mts",
      "import": "./dist/tooling.mjs"
    },
    "./cockpit": {
      "types": "./dist/cockpit.d.mts",
      "import": "./dist/cockpit.mjs"
    },
    "./doctor": {
      "types": "./dist/doctor.d.mts",
      "import": "./dist/doctor.mjs"
    },
    "./app": {
      "types": "./dist/app.d.mts",
      "import": "./dist/app.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@emsenn/organizing-a-knowledge-vault": "0.0.0",
    "@emsenn/organizing-with-agents": "0.0.0",
    "@emsenn/organizing-with-llm-agents": "0.0.1",
    "@emsenn/organizing-with-openai-agents": "0.0.1",
    "@emsenn/producing-content": "0.0.1",
    "@emsenn/relating": "0.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "obsidian": "1.13.1",
    "typescript": "5.9.3"
  },
  "sideEffects": false
}
